# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Auth Configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="codingthunder_super_secret_jwt_key_2026"

# Supabase (Free Database & Authentication Backend)
# Obtain from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"

# Payment Gateway - Razorpay (for India & Global UPI/Cards)
# Register at https://dashboard.razorpay.com to obtain keys
RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="sample_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="sample_razorpay_webhook_secret"

# Payment Gateway - Stripe (Global credit/debit cards)
# Register at https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY="pk_test_sample_publishable_key"
STRIPE_SECRET_KEY="sk_test_sample_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_stripe_webhook_secret"

